{
  "name": "@giltayar/server-side-apps-talk-all-forms",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": ">=24"
  },
  "main": "./src/app.js",
  "type": "module",
  "scripts": {
    "start": "node --watch $INSPECT_APP src/app.js",
    "test": "pnpm test:prettier && pnpm test:oxlint && pnpm test:typescript && pnpm test:node && pnpm test:playwright",
    "test:prettier": "prettier --check .",
    "test:oxlint": "oxlint",
    "test:typescript": "tsgo",
    "test:playwright": "playwright test --config test/e2e",
    "test:node": "node --test 'test/unit/*.test.js'",
    "build": "pnpm build:prettier && pnpm build:docker",
    "build:prettier": "prettier --write .",
    "build:docker": "docker build --platform linux/amd64 -t giltayar/server-side-apps-talk-all-forms:$npm_package_version . --secret id=npmrc,src=$HOME/.npmrc",
    "postpublish": "docker push giltayar/server-side-apps-talk-all-forms:$npm_package_version"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^9.1.3",
    "fastify": "^5.8.5",
    "htm": "^3.1.1",
    "vhtml": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "oxlint": "^1.62.0",
    "prettier": "^3.8.3"
  }
}
